# Server port (optional, default 4000)
PORT=4000

# PostgreSQL connection string (required for Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/focusflow"

# Required for JWT login tokens
JWT_SECRET=your-secret-at-least-32-chars-long

# Optional: token expiry (default 7d)
# JWT_EXPIRES_IN=7d

# AI agent (Phase 3): tool-calling for POST /agent/chat
# If no key below is set, the server uses the rule-based parser fallback.
#
# Claude / Anthropic (either variable name works):
# CLAUDE_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-haiku-4-5-20251001
#
# OpenAI (alternative):
# OPENAI_API_KEY=sk-...
# AGENT_MODEL=gpt-4o-mini
#
# Optional: force provider when multiple keys exist
# AGENT_PROVIDER=anthropic
# AGENT_PROVIDER=openai
