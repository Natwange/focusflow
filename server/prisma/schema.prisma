generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OpaqueTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when the user completes the verification link sent after signup.
  emailVerifiedAt DateTime?

  // Duolingo-style visit streak: increments when you visit on a new day,
  // resets if you miss a full day (timezone-aware via client offset).
  streakCount    Int      @default(0)
  streakDateKey  String?  // YYYY-MM-DD of the last day counted (user-local)
  lastActiveAt   DateTime?

  sessions         FocusSession[]
  goals            Goal[]
  tasks            Task[]
  journalNotes     JournalNote[]
  refreshTokens    RefreshToken[]
  opaqueAuthTokens OpaqueAuthToken[]
}

/// Single-use hashed tokens for password reset and email verification.
model OpaqueAuthToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OpaqueTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

/// Opaque refresh tokens (store hash only). Rotated on each use; reuse of a revoked hash fails.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model JournalNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  content   String   @default("")
  fontStyle String   @default("balanced") // playful | balanced | professional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String?
  duration  Int      // minutes
  startedAt DateTime
  endedAt   DateTime
  createdAt DateTime @default(now())
}

model Goal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  totalUnits Int      // e.g., 30 lessons
  deadline   DateTime
  unitName   String   // "lessons", "chapters"
  availableDays String[] @default(["MON","TUE","WED","THU","FRI","SAT","SUN"])
  maxUnitsPerDay Int?  // optional daily cap for planner; null = unlimited
  createdAt  DateTime @default(now())

  tasks      Task[]
  agentRuns  AgentRun[]
}

/// Logged output from the goal agent (preview runs); used for history and analytics.
model AgentRun {
  id               String   @id @default(cuid())
  goalId           String
  userId           String
  evaluation       Json
  failureAnalysis  Json
  recommendation   String
  nextAction       String
  rebalancePreview Json
  acceptedByUser   Boolean  @default(false)
  createdAt        DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, userId])
}

model Task {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  goalId       String?
  goal         Goal?    @relation(fields: [goalId], references: [id])

  title        String
  estimatedMin Int?
  priority     String   @default("medium") // low | medium | high | urgent
  status       String   @default("todo") // todo | doing | done
  dueDate      DateTime?
  completedAt  DateTime?
  planRunId    String?
  planSource   String?  // initial_generation | rebalance
  unitStart    Int?
  unitEnd      Int?
  createdAt    DateTime @default(now())
}
